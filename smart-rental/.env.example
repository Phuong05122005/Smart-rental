# ==============================================================
# BẢN MẪU BIẾN MÔI TRƯỜNG - SMART RENTAL
# KHÔNG ĐIỀN MẬT KHẨU THẬT VÀO FILE NÀY
# Copy file này thành `.env` ở các thư mục backend/ và database/
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Thay thế `user`, `password`, `localhost`, `5432` và `smart_rental` bằng thông tin thật
DATABASE_URL="postgresql://user:password@localhost:5432/smart_rental?schema=public"

# JWT Secret (Khóa mã hóa bảo mật)
# Thay đổi bằng chuỗi ngẫu nhiên mạnh trên Production
JWT_SECRET=your_jwt_secret_key_here_for_development_only

# CORS
FRONTEND_URL=http://localhost:5173
